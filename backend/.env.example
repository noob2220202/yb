# Database
DATABASE_URL=postgresql+asyncpg://yb:yb@localhost:5432/yb

# Set to true to run entirely on synthetic fixture odds, no external
# accounts needed. Good for local dev / demoing the arbitrage engine.
USE_DEMO_PROVIDER=true

# Pinnacle uses HTTP Basic Auth with your Pinnacle account credentials.
# See https://pinnacleapi.github.io/ for the current base URL and terms.
# Only fill these in if you have a Pinnacle account approved for API access
# and have reviewed their terms of use.
PINNACLE_BASE_URL=https://api.pinnacle.com
PINNACLE_USERNAME=
PINNACLE_PASSWORD=

# The Odds API (https://the-odds-api.com) aggregates many bookmakers and is
# used as the second independent price source needed to compute real
# cross-bookmaker arbitrage (Pinnacle alone cannot produce an arb against
# itself).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com
# Comma-separated The Odds API sport keys, e.g. soccer_epl,soccer_uefa_champs_league
ODDS_API_SPORT_KEYS=soccer_epl

# Comma-separated list of sport keys to poll, using this project's internal
# sport codes (see app/providers/base.py Sport enum).
POLL_SPORTS=soccer

# How often to refresh odds, in seconds.
POLL_INTERVAL_SECONDS=60

# Comma-separated API keys that are allowed to call this service.
# Generate real random values before deploying anywhere public.
API_KEYS=dev-local-key
