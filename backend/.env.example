# Database
DATABASE_URL=postgresql+asyncpg://yb:yb@localhost:5432/yb

# ---------------------------------------------------------------------
# 실데이터 소스 — 둘 다 비워두면 앱은 정상적으로 뜨지만 아무것도 찾지 않습니다
# (더미/가짜 데이터로 대체하지 않습니다. 빈 화면이 곧 "설정 안 됨"의 정답입니다).
# ---------------------------------------------------------------------

# 권장 시작점: The Odds API의 Business 플랜($99/월, 20만 요청/월)은 피나클을
# 포함해 50개 이상 북메이커 배당을 정식 라이선스로 재판매합니다. 피나클 자체
# API 승인(아래)을 기다릴 필요 없이, 이 키 하나로 피나클 실배당 + 다른
# 북메이커 배당을 동시에 받아서 진짜 크로스북 아비트리지 계산이 바로
# 가능해집니다. https://theoddsapi.com/pricing
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com
# Comma-separated The Odds API sport keys, e.g. soccer_epl,soccer_uefa_champs_league
ODDS_API_SPORT_KEYS=soccer_epl

# 피나클 직접 연동 (선택, The Odds API로 이미 피나클 배당을 받고 있다면 불필요).
# HTTP Basic Auth, 비밀번호 10자 제한. 2025-07-23부로 신규 API 접근 신청이
# 막혀 있어 계정만으로는 안 되고 api@pinnacle.com 에 별도 승인 요청이
# 필요합니다. 공식 스펙: https://github.com/pinnacleapi/pinnacleapi-documentation
PINNACLE_BASE_URL=https://api.pinnacle.com
PINNACLE_USERNAME=
PINNACLE_PASSWORD=

# Comma-separated list of sport keys to poll, using this project's internal
# sport codes (see app/providers/base.py Sport enum).
POLL_SPORTS=soccer

# How often to refresh odds, in seconds.
POLL_INTERVAL_SECONDS=60

# Comma-separated API keys that are allowed to call this service.
# Generate real random values before deploying anywhere public.
API_KEYS=dev-local-key

# Telegram 알림 (선택) — 대시보드를 열어두지 않아도 새 확정픽을 받아보고 싶다면 설정.
# 1) 텔레그램에서 @BotFather 에게 /newbot 으로 봇 생성 → 토큰 발급
# 2) 만든 봇과 대화를 한 번 시작한 뒤,
#    https://api.telegram.org/bot<토큰>/getUpdates 로 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 이 마진(%) 이상인 확정픽만 텔레그램으로 알림
TELEGRAM_MIN_MARGIN_PERCENT=1.0
# 이 모델 엣지(%) 이상인 가치 베팅 엣지(확정 아님, 피나클 단독 사용 시 이게 주로 뜸)도
# 별도로 텔레그램에 알림. 확정 픽보다 신뢰도가 낮은 신호라 기본값을 더 높게 잡음.
TELEGRAM_MIN_EDGE_PERCENT=3.0
# 다폴더(교차 경기 파레이) 가치 픽: 이 모델 엣지(%) 이상만 알림. 다리 여러 개를
# 곱한 값이라 단일 마켓보다 신뢰도가 더 낮은 신호라 기본값을 가장 높게 잡음.
TELEGRAM_MIN_PARLAY_EDGE_PERCENT=8.0
